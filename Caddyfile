# Caddyfile — sorta.co.jp reverse-proxy with social-crawler bot detection
#
# Usage (production, single-host setup):
#   API server must be running on localhost:8080
#   Vite SPA static files served from localhost:8081
#   Run: caddy run --config Caddyfile
#
# Bot-crawlers that request a known section URL (e.g. /team) are proxied to
# the API's OG-preview endpoint (/api/share/<section>), which returns fully
# rendered HTML with correct Open Graph meta tags.
#
# Regular browsers are proxied to the SPA (or its static file server),
# which handles client-side rendering and hash/history routing normally.
#
# Social crawlers covered: Slack, LINE, Facebook/Meta, Twitter/X,
# LinkedIn, WhatsApp, Telegram, Discord, Google, Apple, Bing, Yandex

{
  admin off
  auto_https off
}

:80 {

  # Shared bot user-agent snippet (used inline in each named matcher below).
  # LINE's crawler is LineBot/2.0; LINE/ covers variant in-app preview agents.
  # Defined here as a comment for documentation; actual patterns are inlined
  # in each matcher so Caddy can evaluate path + UA together atomically.

  # ── Bot + root path (home section) ───────────────────────────────────────
  @botHome {
    path /
    header_regexp User-Agent `(?i)(Twitterbot|facebookexternalhit|Slackbot-LinkExpanding|LinkedInBot|WhatsApp|TelegramBot|Discordbot|LineBot|LINE\/|Googlebot|bingbot|YandexBot|Applebot|ia_archiver|Pinterestbot|Embedly|Nuzzel|Outbrain|quora link preview|W3C_Validator|rogerbot|msnbot)`
  }
  handle @botHome {
    rewrite * /api/share/home
    reverse_proxy localhost:8080
  }

  # ── Bot + known section path (with and without trailing slash) ────────────
  @botSection {
    path /problem /problem/ /solution /solution/ /use-cases /use-cases/ /team /team/ /why-now /why-now/ /contact /contact/
    header_regexp User-Agent `(?i)(Twitterbot|facebookexternalhit|Slackbot-LinkExpanding|LinkedInBot|WhatsApp|TelegramBot|Discordbot|LineBot|LINE\/|Googlebot|bingbot|YandexBot|Applebot|ia_archiver|Pinterestbot|Embedly|Nuzzel|Outbrain|quora link preview|W3C_Validator|rogerbot|msnbot)`
  }
  handle @botSection {
    # Strip trailing slash before building the API path.
    # /problem or /problem/ → /api/share/problem, /team or /team/ → /api/share/team
    uri strip_suffix /
    rewrite * /api/share{path}
    reverse_proxy localhost:8080
  }

  # ── All /api/* requests → API server ─────────────────────────────────────
  handle /api/* {
    reverse_proxy localhost:8080
  }

  # ── Everything else → SPA (Vite dev/preview server or static file server) ─
  handle {
    reverse_proxy localhost:8081
  }
}
